            >
            <div class="mb-1">
              <label for="email" class="form-label">Email *</label>
              <input
                type="email"
                class="form-control compact-input"
                id="email"
                name="Email"
                required
              />
            </div>
            <div class="mb-1 row">
              <div class="col">
                <label for="jobTitle" class="form-label">Job Title</label>
                <input
                  type="text"
                  class="form-control compact-input"
                  id="jobTitle"
                  name="JobTitle"
                />
              </div>
              <div class="col">
                <label for="company" class="form-label">Company</label>
                <input
                  type="text"
                  class="form-control compact-input"
                  id="company"
                  name="Company"
                />
              </div>
            </div>
            <div class="mb-1 row">
              <div class="col">
                <label for="firstName" class="form-label">First Name</label>
                <input
                  type="text"
                  class="form-control compact-input"
                  id="firstName"
                  name="FirstName"
                />
              </div>
              <div class="col">
                <label for="lastName" class="form-label">Last Name</label>
                <input
                  type="text"
                  class="form-control compact-input"
                  id="lastName"
                  name="LastName"
                />
              </div>
            </div>
            <div class="mb-1">
              <label for="comments" class="form-label">Comments &amp; Notes *</label>
              <textarea
                type="comments"
                class="form-control compact-input"
                id="comments"
                name="Comments"
                required
              ></textarea>
            </div>
            <div class="mb-1 text-center">
              <button type="submit" class="btn btn-sm btn-danger mt-3 px-5">Submit</button>
            </div>
          </form>
          <p id="successMessage" class="d-none p-3 px-lg-5 bg-success text-white">Thank you for providing your contact information. We will be in touch with you shortly.</p>
          <p id="errorMessage" class="d-none p-3 px-lg-5 bg-danger text-white">An error occurred while submitting the form.</p>
          <script>
              const contactFormContainer = document.getElementById('contactFormContainer');
              const form = document.getElementById('contactForm');
              const successMessage = document.getElementById('successMessage');
              const errorMessage = document.getElementById('errorMessage');
              
              form.addEventListener('submit', async function(event) {
                  event.preventDefault();

                  const formData = new FormData(form);

                  const currentDate = new Date().toISOString();
                  formData.append('CurrentDate', currentDate);

                  try {
                      const response = await fetch(
                        form.action,
                        {
                          method: form.method,
                          body: formData,
                        }
                      );

                      if (response.ok) {
                          // Reset form, hide it, hide prev. error and show success message
                          // can't hide the container as error/success resides inside: contactFormContainer.classList.add('d-none');
                          form.classList.add('d-none');
                          errorMessage.classList.add('d-none');
                          successMessage.classList.remove('d-none');
                          form.reset();
                      } else {
                          // Show error message
                          errorMessage.classList.remove('d-none');
                      }
                  } catch (error) {
                      alert('Error submitting form.');
                  }
              });
          </script>
        </div>        

