              <label for="email" class="form-label">Email *</label>
              <input
                type="email"
                class="form-control compact-input"
                id="email"
                name="Email"
                required
              />
            </div>
            <div class="mb-3 row">
              <div class="col">
                <label for="jobTitle" class="form-label">Job Title</label>
                <input
                  type="text"
                  class="form-control compact-input"
                  id="jobTitle"
                  name="JobTitle"
                />
              </div>
              <div class="col">
